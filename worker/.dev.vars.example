# Copia este archivo como .dev.vars en tu entorno local.
# Nunca guardes el archivo real ni una clave privada en GitHub.
GOOGLE_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}

# El entorno staging usa la base Firebase configurada en wrangler.jsonc.
# Para desplegar:
# npx wrangler login
# npx wrangler secret put GOOGLE_SERVICE_ACCOUNT_JSON --env staging
# npx wrangler deploy --env staging
